generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  nickname        String           @unique
  password        String
  isEmailVerified Boolean          @default(false)
  height          Float?
  weight          Float?
  armReach        Float?
  inseam          Float?
  feeds           Feed[]
  routes          ClimbingRoute[]
  createdAt       DateTime         @default(now())
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Feed {
  id           Int      @id @default(autoincrement())
  memo         String   @db.Text
  climbedAt    DateTime
  vGrade       String
  myDifficulty String
  imageUrl     String?
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model ClimbingRoute {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl    String
  imageWidth  Int
  imageHeight Int
  holds       Json
  createdAt   DateTime @default(now())
}
